# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_CLIENT_ID=marketpulse
KAFKA_GROUP_ID=marketpulse-group

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=marketpulse
POSTGRES_USER=marketpulse
POSTGRES_PASSWORD=marketpulse

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Data sources
ENABLE_REAL_STOCK_DATA=false
MOCK_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA,NVDA,META,JPM
MOCK_TICK_INTERVAL_SECONDS=1.0
MOCK_NEWS_INTERVAL_SECONDS=5.0

# Feature / anomaly tuning
ROLLING_WINDOW_SIZE=20
ANOMALY_ZSCORE_THRESHOLD=2.5
VOLUME_SPIKE_RATIO=2.0
NEWS_CORRELATION_WINDOW_MINUTES=30

# Observability
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# MCP
MCP_SERVER_NAME=marketpulse
MCP_API_BASE_URL=http://api:8000
