# ============================================================
# .env.example — Copy to .env and fill in your values.
# NEVER commit .env to git (it is in .gitignore).
# ============================================================

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=<EC2_PUBLIC_IP>:9092
KAFKA_TOPIC=demo_test
KAFKA_DLQ_TOPIC=demo_test_dlq
KAFKA_ALERTS_TOPIC=demo_alerts
# KAFKA_SECURITY_PROTOCOL=SASL_SSL          # Uncomment for production
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512        # Uncomment for production
# KAFKA_SASL_USERNAME=<username>            # Uncomment for production
# KAFKA_SASL_PASSWORD=<password>            # Uncomment for production

# --- Producer ---
PRODUCER_CSV_PATH=data/indexProcessed.csv
PRODUCER_INTERVAL_SECONDS=1

# --- Consumer ---
CONSUMER_GROUP_ID=stock-market-consumer
CONSUMER_BATCH_SIZE=1000
CONSUMER_BATCH_FLUSH_SECONDS=60

# --- S3 ---
S3_BUCKET=<your-s3-bucket-name>
S3_PREFIX=stock-market/raw/

# --- AWS (leave blank if using IAM instance profile / aws configure) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# --- Observability ---
PROMETHEUS_PORT=8000
LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR

# --- AI / LLM (Hero Feature 1) ---
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANOMALY_Z_SCORE_THRESHOLD=2.5
ANOMALY_ROLLING_WINDOW=20

# --- Slack (optional alerts) ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- AWS Glue Schema Registry (Hero Feature 3) ---
# GLUE_SCHEMA_REGISTRY_NAME=stock-market-schema-registry
# GLUE_SCHEMA_NAME=stock-record
